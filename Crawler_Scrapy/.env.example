# 智谱开放平台 GLM-5.2；复制为 .env 后填写真实密钥。
# .env 已被仓库根目录和项目目录的 .gitignore 排除。
ZHIPUAI_API_KEY=replace_with_your_zhipu_api_key

# 硅基流动 Qwen/Qwen3-8B；只有选择 siliconflow/Qwen 时才读取，
# 不会改变或覆盖上面的 GLM-5.2 配置。
SILICONFLOW_API_KEY=replace_with_your_siliconflow_api_key
# 9 站全量任务的第二、第三条独立队列；三个 Key 并行且不写入命令行。
SILICONFLOW_API_KEY2=replace_with_your_second_siliconflow_api_key
SILICONFLOW_API_KEY3=replace_with_your_third_siliconflow_api_key

# 可选：统一全量任务参数（不配置时使用下列默认值）。
FULL_AI_OUTPUT_ROOT=/home/intsig/Crawler_Scrapy/output
FULL_AI_MIN_INTERVAL=1.8
FULL_AI_MIN_FREE_GB=15
FULL_AI_MAX_SITE_ATTEMPTS=3
