# MySQL（必须；替换为实际账号和数据库）
DATABASE_URL="mysql://user:password@127.0.0.1:3306/project_recommendation"

# MongoDB 原始公告和抽取文档（正式导入必须）
MONGODB_URL="mongodb://user:password@127.0.0.1:27017/project_recommendation_documents?authSource=admin"
MONGODB_DATABASE="project_recommendation_documents"

# MinIO 附件对象存储（导入附件时必须）
MINIO_ENDPOINT="127.0.0.1"
MINIO_PORT="9000"
MINIO_USE_SSL="false"
MINIO_ACCESS_KEY="replace-me"
MINIO_SECRET_KEY="replace-me"
MINIO_BUCKET_ATTACHMENTS="notice-attachments"
