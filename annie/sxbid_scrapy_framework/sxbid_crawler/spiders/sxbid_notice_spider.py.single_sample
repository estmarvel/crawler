import scrapy

from sxbid_crawler.columns import COLUMNS, DEFAULT_VALUE, empty_row
from sxbid_crawler.items import SxbidProjectRowItem
from sxbid_crawler.parsers import (
    extract_pdf_urls,
    extract_project_code,
    parse_detail_summary,
    parse_notice_history,
    parse_notice_text,
    parse_related_content,
    type_label,
)
from sxbid_crawler.pdf_ocr import get_pdf_text_from_response


class SxbidNoticeSpider(scrapy.Spider):
    name = "sxbid_notice"
    allowed_domains = ["www.sxbid.com.cn"]

    SAMPLE_URL = (
        "https://www.sxbid.com.cn/f/new/notice/1/"
        "78dc2aa41089423390f59c1ab79d6e85"
    )
    SAMPLE_TITLE = "山大附中晋源学校东侧规划路工程施工项目(1标段)招标公告"

    def __init__(self, sample_url=None, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.sample_url = sample_url or self.SAMPLE_URL

    def make_start_request(self):
        return scrapy.Request(
            self.sample_url,
            callback=self.parse_detail,
            headers={
                "Referer": "https://www.sxbid.com.cn/f/new/notice/list/41",
                "Accept-Language": "zh-CN,zh;q=0.9",
            },
            dont_filter=True,
        )

    async def start(self):
        yield self.make_start_request()

    def start_requests(self):
        yield self.make_start_request()

    def parse_detail(self, response):
        row = empty_row("")
        parse_detail_summary(response.text, row)

        row["公告类型"] = type_label(self.SAMPLE_TITLE, "notice")
        row["详情链接"] = response.url
        row["来源栏目"] = "样例详情页"
        row["公告历史"] = f"{self.SAMPLE_TITLE}|{response.url}"
        parse_notice_history(response.text, response.url, row)

        pdf_urls = extract_pdf_urls(response.text)
        pdf_url = response.urljoin(pdf_urls[0]) if pdf_urls else ""

        project_code = extract_project_code(response.text)
        if not project_code:
            self.logger.warning("详情页未找到项目编号")
            yield from self.finish_or_request_pdf(row, pdf_url, response.url)
            return

        related_url = (
            "https://www.sxbid.com.cn/f/new/notice/"
            f"getRelatedContent/1/{project_code}"
        )

        yield scrapy.Request(
            related_url,
            callback=self.parse_related,
            cb_kwargs={"row": row, "pdf_url": pdf_url},
            headers={"Referer": response.url},
            dont_filter=True,
        )

    def parse_related(self, response, row, pdf_url):
        parse_related_content(response.text, row)
        yield from self.finish_or_request_pdf(
            row,
            pdf_url,
            response.request.headers.get("Referer", b"").decode(
                "utf-8",
                errors="ignore",
            ),
        )

    def finish_or_request_pdf(self, row, pdf_url, detail_url):
        if not pdf_url:
            self.logger.warning("详情页未找到PDF，直接输出当前字段")
            yield self.row_to_item(row)
            return

        yield scrapy.Request(
            pdf_url,
            callback=self.parse_pdf,
            cb_kwargs={"row": row},
            headers={"Referer": detail_url or self.sample_url},
            dont_filter=True,
        )

    def parse_pdf(self, response, row):
        pdf_text = get_pdf_text_from_response(response.url, response.body)

        self.logger.info(
            "PDF正文提取完成: bytes=%s text_chars=%s",
            len(response.body),
            len(pdf_text),
        )

        if pdf_text:
            parse_notice_text(pdf_text, row)
        else:
            self.logger.warning("PDF未提取到文字，联系字段保持为无")

        # TODO: 扩展“相关信息”中的公告历史。
        # TODO: 规则完成后，只把缺失字段交给AI补充。
        yield self.row_to_item(row)

    @staticmethod
    def row_to_item(row):
        item = SxbidProjectRowItem()
        for column in COLUMNS:
            item[column] = row.get(column, DEFAULT_VALUE)
        return item
