from urllib.parse import urljoin

import scrapy

from sxbid_crawler.ai_service import supplement_row_with_ai
from sxbid_crawler.columns import COLUMNS, DEFAULT_VALUE, empty_row
from sxbid_crawler.items import SxbidProjectRowItem
from sxbid_crawler.parsers import (
    classify_title, clean_title, type_label,
    get_content_text_from_html,
    parse_plan_detail_from_html,
    parse_notice_detail_from_text,
    parse_supervision_detail_from_text,
)
from sxbid_crawler.pdf_ocr import extract_pdf_url_from_html, get_pdf_text_from_response
from sxbid_crawler.text_utils import append_unique, make_publish_part, merge_into_row, normalize_inline


class SxbidNoticeSpider(scrapy.Spider):
    name = "sxbid_notice"
    BASE_URL = "https://prec.sxzwfw.gov.cn"
    LIST_URL = "https://prec.sxzwfw.gov.cn/queryContent-jyxx.jspx"
    CHANNEL = {
        "招标计划": 198,
        "招标公告": 12,
        "变更公告": 13,
        "中标候选人": 14,
        "中标结果": 15,
    }

    def __init__(self, max_pages=3, crawl_days=1, use_playwright="false", *args, **kwargs):
        super().__init__(*args, **kwargs)
        self.max_pages = int(max_pages)
        self.crawl_days = int(crawl_days) if crawl_days else 1
        self.use_playwright = str(use_playwright).lower() == "true"

    async def start(self):
        for req in self._make_start_requests():
            yield req

    def start_requests(self):
        yield from self._make_start_requests()

    def _make_start_requests(self):
        self.logger.info(f"生成起始请求: 频道数={len(self.CHANNEL)}, 每频道页数={self.max_pages}")
        for channel_name, channel_id in self.CHANNEL.items():
            for page_no in range(1, self.max_pages + 1):
                yield scrapy.FormRequest(
                    url=self.build_list_url(page_no),
                    formdata=self.build_list_form(channel_id),
                    callback=self.parse_list,
                    headers={
                        "Referer": "https://prec.sxzwfw.gov.cn/jyxx/index.jhtml",
                        "Content-Type": "application/x-www-form-urlencoded",
                    },
                    meta={"channel_name": channel_name, "channel_id": channel_id, "page_no": page_no},
                    dont_filter=True,
                )

    def build_list_url(self, page_no: int) -> str:
        if page_no <= 1:
            return self.LIST_URL
        return self.LIST_URL.replace("queryContent-", f"queryContent_{page_no}-")

    def build_list_form(self, channel_id: int) -> dict:
        return {
            "title": "",
            "channelId": str(channel_id),
            "inDates": str(self.crawl_days),
            "beginTime": "",
            "endTime": "",
            "origin": "",
            "ext": "",
        }

    def parse_list(self, response):
        channel_name = response.meta["channel_name"]
        page_no = response.meta["page_no"]
        self.logger.info(f"解析列表页: {channel_name} page={page_no} status={response.status}")
        items = response.css(".cs_two_c_2")
        if not items:
            self.logger.warning(f"未提取到列表项: {channel_name} page={page_no}")
            return
        for item in items:
            href = item.attrib.get("href", "")
            if not href:
                continue
            link = urljoin(self.BASE_URL, href)
            link = link.replace("http://prec.sxzwfw.gov.cn:80", "https://prec.sxzwfw.gov.cn")
            link = link.replace("http://prec.sxzwfw.gov.cn", "https://prec.sxzwfw.gov.cn")
            raw_title = normalize_inline("".join(item.css(".cs_bz_cont ::text, .cs_bz_cont::text").getall()))
            date = normalize_inline("".join(item.css(".cs_bz_cont_1_time ::text, .cs_bz_cont_1_time::text").getall()))
            if not raw_title:
                raw_title = normalize_inline("".join(item.css("::text").getall()))
            title_type = classify_title(raw_title)
            if title_type == "skip":
                self.logger.info(f"跳过控制价/限价类公告: {raw_title}")
                continue
            project_name = clean_title(raw_title)
            forced_type = self.get_forced_type(channel_name, title_type)
            meta = {
                "raw_title": raw_title,
                "project_name": project_name,
                "date": date,
                "channel_name": channel_name,
                "forced_type": forced_type,
                "detail_url": link,
            }
            if self.use_playwright:
                meta.update({"playwright": True, "playwright_include_page": False})
            yield scrapy.Request(link, callback=self.parse_detail, meta=meta, dont_filter=False)

    def get_forced_type(self, channel_name: str, title_type: str) -> str:
        if channel_name == "招标计划":
            return "plan"
        if title_type and title_type != "unknown":
            return title_type
        if channel_name == "变更公告":
            return "amendment"
        if channel_name == "中标候选人":
            return "candidate"
        if channel_name == "中标结果":
            return "result"
        if channel_name == "招标公告":
            return "notice"
        return "unknown"

    def parse_detail(self, response):
        pdf_url = extract_pdf_url_from_html(response.text, response.url)
        if pdf_url:
            meta = dict(response.meta)
            meta["html_text_before_pdf"] = get_content_text_from_html(response.text)
            self.logger.info(f"发现PDF公告，转入PDF解析: {pdf_url}")
            yield scrapy.Request(pdf_url, callback=self.parse_pdf_detail, meta=meta, dont_filter=False)
            return
        detail_text = get_content_text_from_html(response.text)
        row = self.build_row(response.meta, response.text, detail_text, response.url, is_html=True)
        yield self.row_to_item(row)

    def parse_pdf_detail(self, response):
        pdf_url = response.url
        pdf_text = get_pdf_text_from_response(pdf_url, response.body)
        if not pdf_text:
            pdf_text = response.meta.get("html_text_before_pdf", "")
        row = self.build_row(response.meta, "", pdf_text, response.meta.get("detail_url", pdf_url), is_html=False)
        yield self.row_to_item(row)

    def build_row(self, meta: dict, html: str, detail_text: str, detail_url: str, is_html: bool) -> dict:
        raw_title = meta.get("raw_title", "")
        project_name = meta.get("project_name", "") or clean_title(raw_title)
        date = meta.get("date", "")
        forced_type = meta.get("forced_type", "unknown")
        label = type_label(raw_title, forced_type)
        row = empty_row(project_name)
        row["公告类型"] = append_unique(row["公告类型"], label)
        row["发布日期"] = append_unique(row["发布日期"], make_publish_part(label, date))
        row["公告历史"] = append_unique(row["公告历史"], f"{raw_title}|{detail_url}")

        if forced_type == "plan":
            if is_html:
                row = merge_into_row(row, parse_plan_detail_from_html(html))
        elif forced_type == "notice":
            row = merge_into_row(row, parse_notice_detail_from_text(detail_text))
        elif forced_type in ("candidate", "result"):
            row = merge_into_row(row, parse_supervision_detail_from_text(detail_text))
        elif forced_type in ("amendment", "terminate"):
            # 不做历史回填；只保存公告基础信息。需要时 AI 仍可按缺失字段补。
            pass

        row = supplement_row_with_ai(row, detail_text, link=detail_url)
        return row

    def row_to_item(self, row: dict):
        item = SxbidProjectRowItem()
        for col in COLUMNS:
            item[col] = row.get(col, DEFAULT_VALUE)
        return item
