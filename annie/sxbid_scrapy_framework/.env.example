# ===== 基础输出 =====
CRAWLER_OUTPUT_DIR=output
LOG_DIR=logs
LOG_LEVEL=INFO

# ===== 并发：充分利用代理池/IP池 =====
# Scrapy 本身是异步并发，这里相当于旧脚本里“多线程”的作用
CRAWLER_CONCURRENT_REQUESTS=32
CRAWLER_CONCURRENT_REQUESTS_PER_DOMAIN=16
CRAWLER_DOWNLOAD_DELAY=0
REACTOR_THREADPOOL_MAXSIZE=32

# ===== 代理池 =====
USE_PROXY=false
PROXY_DIRECT_FALLBACK=true
# 方式1：复用旧项目 /home/intsig/zwx/shanxi/proxy_pool.py
PROXY_PROVIDER=legacy
LEGACY_PROXY_POOL_PATH=/home/intsig/zwx/shanxi/proxy_pool.py
PROXY_NUM=30
PROXY_TIME=5
PROXY_PORT=2
PROXY_MIN_SIZE=8
PROXY_MAX_FAIL_COUNT=1
# 方式2：通用代理API。PROXY_PROVIDER=api 时启用
PROXY_API_URL=
PROXY_TTL_SECONDS=180

# ===== AI 兜底 =====
ENABLE_AI=true
DMX_API_KEY=
AI_BASE_URL=https://vip.dmxapi.com/v1
AI_MODEL=glm-4.6-thinking
AI_MIN_INTERVAL_SECONDS=1.0
AI_RETRY_BASE_SECONDS=3
AI_RETRY_MAX_SECONDS=30

# ===== PDF / OCR =====
ENABLE_PDF_OCR=true
OCR_MODEL=qwen-vl-ocr
PDF_CACHE_DIR=pdf_cache
OCR_CACHE_DIR=ocr_cache
PDF_TEXT_MAX_PAGES=20
OCR_MAX_PAGES=10
OCR_DPI=160
PDF_TEXT_MIN_CHARS=500
